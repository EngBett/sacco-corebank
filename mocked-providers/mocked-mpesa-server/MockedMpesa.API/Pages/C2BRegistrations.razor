@page "/c2b-registrations"
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer
@attribute [Authorize]
@using MockedMpesa.API.Data
@using MockedMpesa.API.Models
@using MongoDB.Driver
@inject MockMpesaDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Mock M-Pesa - C2B Registrations</PageTitle>

<div class="card shadow bg-dark text-white">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-shield-check"></i> C2B Confirmation Registrations
                </h3>
                <button class="btn btn-light btn-sm" @onclick="RefreshRegistrations">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading C2B registrations...</p>
                </div>
            }
            else if (registrations == null || !registrations.Any())
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle"></i> No C2B registrations found.
                    <br/>
                    <small class="text-muted">Use the Admin API to register shortcodes: POST /api/admin/c2b/register</small>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped table-dark">
                        <thead class="table-primary">
                            <tr>
                                <th>ID</th>
                                <th>ShortCode</th>
                                <th>Validation URL</th>
                                <th>Confirmation URL</th>
                                <th>Response Type</th>
                                <th>Registered At</th>
                                <th>Updated At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var registration in registrations)
                            {
                                <tr>
                                    <td>@registration.Id</td>
                                    <td>
                                        <span class="badge bg-success">@registration.ShortCode</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(registration.ValidationUrl))
                                        {
                                            <small class="text-break">@registration.ValidationUrl</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(registration.ConfirmationUrl))
                                        {
                                            <small class="text-break">@registration.ConfirmationUrl</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(registration.ResponseType == "Completed" ? "bg-success" : "bg-danger")">
                                            @registration.ResponseType
                                        </span>
                                    </td>
                                    <td>
                                        <small>@registration.RegisteredAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        @if (registration.UpdatedAt.HasValue)
                                        {
                                            <small>@registration.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteRegistration(registration.Id)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <div class="alert alert-info">
                        <strong><i class="bi bi-info-circle"></i> Total Registrations:</strong> @registrations.Count
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Registration Info Card -->
    <div class="card shadow bg-dark text-white mt-4">
        <div class="card-header bg-secondary">
            <h5 class="mb-0"><i class="bi bi-question-circle"></i> How C2B Registrations Work</h5>
        </div>
        <div class="card-body">
            <p>C2B (Customer to Business) registrations allow shortcodes to receive confirmation callbacks when STK Push transactions are completed.</p>
            
            <h6 class="text-success mt-3">Register a Shortcode:</h6>
            <pre class="bg-secondary p-3 rounded"><code>POST http://localhost:5005/api/admin/c2b/register
Content-Type: application/json

{
  "ShortCode": "600966",
  "ValidationURL": "http://localhost:5003/api/payments/c2b/validation",
  "ConfirmationURL": "http://localhost:5003/api/payments/c2b/confirmation",
  "ResponseType": "Completed"
}</code></pre>

            <h6 class="text-success mt-3">What Happens:</h6>
            <ul>
                <li>When an STK Push transaction uses this shortcode, <strong>two callbacks</strong> are sent:</li>
                <li><strong>1. STK Push Callback</strong> - Standard M-Pesa callback with transaction details</li>
                <li><strong>2. C2B Confirmation</strong> - Additional callback to the registered ConfirmationURL with transaction details</li>
            </ul>

            <h6 class="text-warning mt-3">C2B Confirmation Payload:</h6>
            <pre class="bg-secondary p-3 rounded"><code>{
  "TransactionType": "PayBill",
  "TransID": "RKL51ZDR4F",
  "TransTime": "20231121121325",
  "TransAmount": "100.00",
  "BusinessShortCode": "600966",
  "BillRefNumber": "XYZ123AB-aB3x7Km9",
  "MSISDN": "254712345678",
  "FirstName": "John",
  "MiddleName": "Doe",
  "LastName": "Smith"
}</code></pre>
        </div>
    </div>

@code {
    private List<C2BRegistration>? registrations;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegistrations();
    }

    private async Task LoadRegistrations()
    {
        isLoading = true;
        try
        {
            registrations = await DbContext.C2BRegistrations
                .Find(FilterDefinition<C2BRegistration>.Empty)
                .SortByDescending(r => r.RegisteredAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading C2B registrations: {ex.Message}");
            registrations = new List<C2BRegistration>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshRegistrations()
    {
        await LoadRegistrations();
    }

    private async Task DeleteRegistration(string id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "Are you sure you want to delete this C2B registration?");
        
        if (confirmed)
        {
            try
            {
                var filter = Builders<C2BRegistration>.Filter.Eq(r => r.Id, id);
                var result = await DbContext.C2BRegistrations.DeleteOneAsync(filter);
                
                if (result.DeletedCount > 0)
                {
                    await LoadRegistrations();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting C2B registration: {ex.Message}");
            }
        }
    }
}
