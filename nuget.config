<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-scoped NuGet sources: only nuget.org, so restores are reproducible on every machine and in CI. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
