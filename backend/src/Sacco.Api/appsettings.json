{
  "ConnectionStrings": {
    "Sacco": "Host=localhost;Port=5432;Database=sacco;Username=sacco;Password=sacco"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Tenancy": {
    "HeaderName": "X-Tenant",
    "DefaultTenantSlug": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [],
    "_comment": "Portal origin(s) allowed to open the notifications hub cross-origin, e.g. https://portal.example.co.ke"
  },
  "IdentityServer": {
    "IssuerUri": "https://api.sacco.example",
    "SigningCredential": "Developer",
    "CertificatePath": null,
    "CertificateBase64": null,
    "CertificatePassword": null,
    "Clients": [
      {
        "ClientId": "portal-bff",
        "ClientName": "Staff & member portal (BFF)",
        "GrantTypes": [
          "code"
        ],
        "ClientSecret": null,
        "RedirectUris": [],
        "PostLogoutRedirectUris": [],
        "AllowOfflineAccess": true,
        "AccessTokenLifetimeSeconds": 900
      },
      {
        "ClientId": "mobile",
        "ClientName": "Member mobile app",
        "GrantTypes": [
          "code"
        ],
        "RequireClientSecret": false,
        "RedirectUris": [
          "sacco://auth/callback"
        ],
        "AllowOfflineAccess": true,
        "AccessTokenLifetimeSeconds": 900
      }
    ],
    "_comment": "Production sets SigningCredential=Certificate plus CertificateBase64/CertificatePath from the secrets manager; the host refuses to start otherwise."
  },
  "Turnstile": {
    "Sandbox": false,
    "SecretKey": null
  },
  "PublicApi": {
    "ApiKey": null
  },
  "Payments": {
    "MPesa": {
      "Mode": "Sandbox",
      "BaseUrl": "https://api.safaricom.co.ke/",
      "CallbackBaseUrl": null
    },
    "AirtelMoney": {
      "Mode": "Sandbox"
    },
    "Bank": {
      "Mode": "Sandbox"
    },
    "CallbackTimeoutMinutes": 3,
    "SandboxAutoCallbackSeconds": 0,
    "_comment": "Mode=Live plus credentials from the secrets manager switches a provider; see docs/integrations/payment-providers.md and docs/runbooks/production-cutover.md"
  }
}