{
  "Database": {
    "MigrateOnStartup": true
  },
  "Tenancy": {
    "DefaultTenantSlug": "demo"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Demo": {
    "Enabled": true,
    "Message": "This is a demonstration of the Icodeio SACCO platform, filled with sample data. The platform is available to buy for your SACCO.",
    "ContactEmail": "sales@icodeio.example.co.ke"
  },
  "Identity": {
    "Accounts": {
      "PublicOrigin": "http://localhost:5000",
      "PortalUrl": "http://localhost:3000"
    },
    "Mfa": {
      "ActiveKeyId": "dev",
      "EncryptionKeys": {
        "dev": "s7UkX9tQD/AYxJOJXcj6a6U1A6oj57FRs2NPWsxBcGY="
      }
    }
  },
  "IdentityServer": {
    "IssuerUri": "http://localhost:5000",
    "SigningCredential": "Developer",
    "Clients": [
      {
        "ClientId": "portal-bff",
        "ClientName": "Staff & member portal (BFF)",
        "GrantTypes": [
          "code"
        ],
        "ClientSecret": "portal-bff-dev-secret",
        "RedirectUris": [
          "http://localhost:3000/api/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:3000/"
        ],
        "AllowOfflineAccess": true
      },
      {
        "ClientId": "mobile",
        "ClientName": "Member mobile app (native phone+PIN, member only)",
        "GrantTypes": [
          "password"
        ],
        "RequireClientSecret": false,
        "AllowOfflineAccess": true
      },
      {
        "ClientId": "sacco-cli",
        "ClientName": "Demo CLI / integration tests (password grant, first-party only)",
        "GrantTypes": [
          "password"
        ],
        "ClientSecret": "sacco-cli-dev-secret",
        "AllowOfflineAccess": true
      }
    ]
  },
  "Turnstile": {
    "Sandbox": true
  },
  "PublicApi": {
    "ApiKey": "sandbox-public-api-key"
  },
  "Payments": {
    "SandboxAutoCallbackSeconds": 5
  },
  "Notifications": {
    "Sms": {
      "Mode": "Live",
      "Provider": "Mock",
      "Mock": { "BaseUrl": "http://localhost:5108/" }
    },
    "Email": {
      "Mode": "Live",
      "Smtp": { "Host": "localhost", "Port": 1025, "UseStartTls": false }
    },
    "_comment": "Local dev default: `docker compose up -d postgres mailpit mocked-sms`, then open http://localhost:8025 (mail) and http://localhost:5108 (SMS) to see what the API actually sent. Delivery is best-effort — a failed send is logged and left retryable on /api/notifications/outbox, it never blocks the workflow that raised the notification."
  }
}