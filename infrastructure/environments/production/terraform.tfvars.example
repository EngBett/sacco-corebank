# Copy to terraform.tfvars (git-ignored). No secrets belong here — those live in Secrets Manager.
region             = "eu-west-1"
domain             = "production.sacco.example.co.ke"
certificate_arn    = "arn:aws:acm:eu-west-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
image_tag          = "sha-abcdef0"
desired_count      = 1
# Production: Live providers only after docs/runbooks/production-cutover.md is complete and the
# provider credentials are stored in Secrets Manager. Restrict webhooks to Safaricom's published ranges.
mpesa_mode            = "Live"
webhook_allowed_cidrs = ["196.201.214.0/24", "196.201.214.200/32"]
desired_count         = 2
db_instance_class     = "db.m6g.large"
